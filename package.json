{
  "name": "dsh-takeover",
  "version": "0.10.0",
  "private": true,
  "description": "会话移交：右键任意会话「移交会话」，新建一个上下文干净的会话接手，老会话原样保留；附清理页管理交接文档",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "docs",
    "screenshots.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "handoff",
    "handover",
    "takeover",
    "context"
  ],
  "license": "MIT",
  "author": "维庸化石（不识幻庵）",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhukeu2-lang/dsh-takeover.git"
  },
  "homepage": "https://github.com/zhukeu2-lang/dsh-takeover#readme",
  "bugs": {
    "url": "https://github.com/zhukeu2-lang/dsh-takeover/issues"
  }
}
